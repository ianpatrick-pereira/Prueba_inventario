# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a Git.

# Clave secreta de Django. Genera una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esta-clave-por-una-generada-no-uses-esta

# True solo en desarrollo; en producción debe ser False (o no definirse).
DEBUG=True

# Hosts permitidos separados por coma.
ALLOWED_HOSTS=127.0.0.1,localhost
